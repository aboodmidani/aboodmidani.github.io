---
import PageLoader from "@/components/PageLoader.astro";
import StructuredData from "@/components/StructuredData.astro";
import { ViewTransitions } from "astro:transitions";
import { t } from "@/i18n";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'project' | 'service' | 'contact';
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  datePublished,
  dateModified,
  breadcrumbs
} = Astro.props;

const locale = Astro.currentLocale === "de" ? "de" : "en";
const otherLocale = locale === "de" ? "en" : "de";

const defaults: Record<string, { description: string; keywords: string; language: string; ogLocale: string }> = {
  en: {
    description: "Abdalrahman Midani — senior front-end developer and cybersecurity specialist in Ochtrup, North Rhine-Westphalia. Building secure, high-performance web applications for businesses in Germany.",
    keywords: "web developer north rhine westphalia, cybersecurity specialist germany, front-end developer NRW, cybersecurity ochtrup, web security expert nordrhein-westfalen, senior front-end developer germany, vulnerability analysis, web application security, abdalrahman midani",
    language: "English",
    ogLocale: "en",
  },
  de: {
    description: "Abdalrahman Midani — Senior Front-End-Entwickler und Cybersecurity-Spezialist in Ochtrup, Nordrhein-Westfalen. Ich baue sichere, schnelle Webanwendungen für Unternehmen in Deutschland.",
    keywords: "Webentwickler Nordrhein-Westfalen, Cybersecurity-Spezialist Deutschland, Front-End-Entwickler NRW, Cybersicherheit Ochtrup, Web-Sicherheitsexperte, Senior Front-End-Entwickler Deutschland, Schwachstellenanalyse, Webanwendungssicherheit, abdalrahman midani",
    language: "Deutsch",
    ogLocale: "de",
  },
};

const finalDescription = description ?? defaults[locale].description;
const finalKeywords = defaults[locale].keywords;
const languageLabel = defaults[locale].language;
const ogLocale = defaults[locale].ogLocale;

const siteUrl = "https://aboodmidani.github.io";
const imageUrl = "https://aboodmidani.github.io/og-image.png";
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, siteUrl).toString();
const enUrl = new URL(currentPath.replace(/^\/de\/?/, "/en/") || "/en/", siteUrl).toString();
const deUrl = new URL(currentPath.replace(/^\/en\/?/, "/de/") || "/de/", siteUrl).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={finalKeywords} />
    <meta name="author" content="Abdalrahman Midani" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="language" content={languageLabel} />
    <meta name="revisit-after" content="7 days" />
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang for SEO -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <!-- Geo Tags -->
    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Ochtrup" />
    <meta name="geo.position" content="52.2079;7.1894" />
    <meta name="ICBM" content="52.2079, 7.1894" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Abdalrahman Midani - Web Developer & Cybersecurity Specialist" />
    <meta property="og:site_name" content="Abdalrahman Midani" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocale === "en" ? "de" : "en"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content="@aboodmidani" />
    <meta name="twitter:site" content="@aboodmidani" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#101010" />
    <meta name="msapplication-TileColor" content="#101010" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="S1Sb_zVosbwYnqVjEtJGsd7BDy357vB0IaDJxxHPooA" />

    <!-- Performance: Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-833KX5000V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-833KX5000V', { send_page_view: false });
      document.addEventListener('astro:page-load', function() {
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title
        });
      });
    </script>

    <!-- Fonts: Non-render-blocking -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Generator Tag -->
    <meta name="generator" content="Astro v5" />

    <!-- Structured Data -->
    <StructuredData
      type={ogType}
      title={title}
      description={finalDescription}
      image={imageUrl}
      datePublished={datePublished}
      dateModified={dateModified}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-[--background] md:px-48 lg:px-20 px-9">
    <!-- Cinematic overlays -->
    <div class="cinematic-grain" aria-hidden="true"></div>
    <div class="cinematic-vignette" aria-hidden="true"></div>
    <div class="cinematic-glow" aria-hidden="true"></div>
    <div class="cinematic-glow cinematic-glow-2" aria-hidden="true"></div>

    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--sec)] focus:text-[var(--background)] focus:rounded-lg focus:font-medium"
    >
      {locale === "de" ? "Zum Hauptinhalt springen" : "Skip to main content"}
    </a>

    <PageLoader />

    <main id="main-content" class="page-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #8fff9f;
    --white: #dfdfdf;
    --white-icon: #b3b3b3;
    --white-icon-tr: rgba(243, 243, 243, 0.06);
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  h1, h2, h3, .font-display {
    font-family: "Space Grotesk", "Montserrat", sans-serif;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  p {
    line-height: 1.6;
    color: var(--white-icon);
  }

  strong {
    color: var(--white);
    font-weight: 600;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  :focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 2px;
  }

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 8px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #444;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #333 var(--background);
  }

  /* === CINEMATIC OVERLAYS === */

  /* Film grain */
  .cinematic-grain {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
    mix-blend-mode: overlay;
  }

  /* Vignette */
  .cinematic-vignette {
    position: fixed;
    inset: 0;
    z-index: 9997;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.4) 100%);
  }

  /* Ambient glow blobs */
  .cinematic-glow {
    position: fixed;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(143, 255, 159, 0.03) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: -1;
    animation: glowDrift 20s ease-in-out infinite alternate;
  }

  .cinematic-glow-2 {
    top: auto;
    right: auto;
    bottom: -20%;
    left: -10%;
    background: radial-gradient(circle, rgba(143, 255, 159, 0.02) 0%, transparent 70%);
    animation: glowDrift2 25s ease-in-out infinite alternate;
  }

  @keyframes glowDrift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-40px, 30px) scale(1.1); }
    100% { transform: translate(20px, -20px) scale(0.95); }
  }

  @keyframes glowDrift2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -40px) scale(1.15); }
    100% { transform: translate(-20px, 20px) scale(0.9); }
  }

  /* === PAGE TRANSITIONS === */

  .page-content {
    animation: pageReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes pageReveal {
    from {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Staggered hero reveal */
  .hero-reveal > * {
    opacity: 0;
    transform: translateY(20px);
    animation: heroRevealItem 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-reveal > *:nth-child(1) { animation-delay: 0.1s; }
  .hero-reveal > *:nth-child(2) { animation-delay: 0.25s; }
  .hero-reveal > *:nth-child(3) { animation-delay: 0.4s; }
  .hero-reveal > *:nth-child(4) { animation-delay: 0.55s; }

  @keyframes heroRevealItem {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Section fade-in with cinematic feel */
  .fade-in-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  section:first-of-type {
    opacity: 1 !important;
    transform: none !important;
  }

  /* === CINEMATIC CARDS === */

  .card-cinematic {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-cinematic:hover {
    border-color: rgba(143, 255, 159, 0.2);
    transform: translateY(-1px);
  }

  /* Cinematic image overlay */
  .img-cinematic {
    position: relative;
    overflow: hidden;
  }

  .img-cinematic::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 16, 16, 0.7) 0%, transparent 50%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .img-cinematic:hover::after {
    opacity: 0.5;
  }

  /* Cinematic divider line */
  .divider-cinematic {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(143, 255, 159, 0.3), transparent);
    border: none;
  }

  /* Screen reader only class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .cinematic-grain,
    .cinematic-glow,
    .cinematic-glow-2 {
      display: none;
    }
  }
</style>

<script>
  // Intersection Observer for fade-in animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px"
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && !entry.target.dataset.animated) {
        entry.target.classList.add("visible");
        entry.target.dataset.animated = "true";
      }
    });
  }, observerOptions);

  function isInViewport(element: Element) {
    const rect = element.getBoundingClientRect();
    return (
      rect.top < window.innerHeight * 0.85 &&
      rect.bottom > 0
    );
  }

  document.querySelectorAll("section").forEach((section) => {
    if (!isInViewport(section)) {
      section.classList.add("fade-in-up");
      observer.observe(section);
    } else {
      section.classList.add("visible");
      section.dataset.animated = "true";
    }
  });

  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: "smooth" });
      }, 100);
    }
  }

  var readingSpans = document.querySelectorAll('.reading-time');
  if (readingSpans.length) {
    var article = document.querySelector('article') || document.querySelector('.prose');
    if (article) {
      var text = article.textContent || '';
      var words = text.trim().split(/\s+/).length;
      var mins = Math.max(1, Math.ceil(words / 200));
      for (var i = 0; i < readingSpans.length; i++) {
        readingSpans[i].textContent = mins;
      }
    }
  }
</script>
