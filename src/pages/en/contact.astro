---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;
---

<Layout
  title="Contact | Abdalrahman Midani — Web Developer in Ochtrup, NRW"
  description="Get in touch with Abdalrahman Midani — senior front-end developer and cybersecurity specialist based in Ochtrup, North Rhine-Westphalia."
  ogType="contact"
  breadcrumbs={[
    { name: "Contact", url: "https://aboodmidani.github.io/en/contact/" }
  ]}
>
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs text-[var(--sec)] uppercase tracking-[0.3em] mb-3 font-medium"><T key="contactPage.tagline" /></p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4"><T key="contactPage.heading" /></h1>
      <p class="text-lg text-[var(--white-icon)] max-w-2xl mb-12">
        <T key="contactPage.subtitle" />
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="text-[var(--white-icon)] space-y-4">
          <p class="mb-4">
            I'm based in <strong class="text-[var(--white)]">Ochtrup, North Rhine-Westphalia</strong> and available for projects throughout Germany and remotely across Europe.
          </p>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Ochtrup, Germany</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <a href="tel:+4915771454456" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">+49 15771454456</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <a href="mailto:aboodmidani0@gmail.com" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">aboodmidani0@gmail.com</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
            <a href="https://tryhackme.com/p/Jbril" target="_blank" rel="noopener noreferrer" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">TryHackMe — @Jbril</a>
          </div>
        </div>

        <div>
          <form
            id="contact-form"
            action="https://formspree.io/f/manydoqj"
            method="POST"
            class="flex flex-col gap-4"
          >
            <div class="flex flex-col gap-1">
              <input
                type="text"
                name="from_name"
                placeholder="Your Name"
                required
                minlength="2"
                maxlength="100"
                class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-colors"
              />
              <span id="name-error" class="text-red-400 text-sm hidden">Please enter your name (2-100 characters)</span>
            </div>
            <div class="flex flex-col gap-1">
              <input
                type="email"
                name="reply_to"
                placeholder="Your Email"
                required
                class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-colors"
              />
              <span id="email-error" class="text-red-400 text-sm hidden">Please enter a valid email address</span>
            </div>
            <div class="flex flex-col gap-1">
              <textarea
                name="message"
                placeholder="Your Message"
                rows="5"
                required
                minlength="10"
                maxlength="1000"
                class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-colors resize-none"
              ></textarea>
              <span id="message-error" class="text-red-400 text-sm hidden">Please enter a message (10-1000 characters)</span>
              <span id="char-count" class="text-[var(--white-icon)] text-xs text-right">0/1000</span>
            </div>
            <div id="form-status" class="hidden p-3 rounded-xl text-sm"></div>
            <button
              type="submit"
              class="px-6 py-3 bg-[var(--sec)] text-black font-medium rounded-xl hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-text"><T key="contactPage.formSend" /></span>
              <span id="btn-loading" class="hidden">Sending...</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  var form = document.getElementById("contact-form");
  if (form) {
    var nameInput = form.querySelector('input[name="from_name"]');
    var emailInput = form.querySelector('input[name="reply_to"]');
    var messageInput = form.querySelector('textarea[name="message"]');
    var nameError = document.getElementById("name-error");
    var emailError = document.getElementById("email-error");
    var messageError = document.getElementById("message-error");
    var charCount = document.getElementById("char-count");
    var formStatus = document.getElementById("form-status");
    var btnText = document.getElementById("btn-text");
    var btnLoading = document.getElementById("btn-loading");

    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function showError(input, errorEl, message) {
      input.classList.add("border-red-500");
      input.classList.remove("border-[var(--white-icon-tr)]");
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }

    function clearError(input, errorEl) {
      input.classList.remove("border-red-500");
      input.classList.add("border-[var(--white-icon-tr)]");
      errorEl.classList.add("hidden");
    }

    function showStatus(message, isError) {
      formStatus.textContent = message;
      formStatus.className = "p-3 rounded-xl text-sm " + (isError ? "bg-red-500/10 text-red-400 border border-red-500/20" : "bg-green-500/10 text-green-400 border border-green-500/20");
      formStatus.classList.remove("hidden");
    }

    function setLoading(loading) {
      btnText.classList.toggle("hidden", loading);
      btnLoading.classList.toggle("hidden", !loading);
      form.querySelector('button[type="submit"]').disabled = loading;
    }

    if (messageInput && charCount) {
      messageInput.addEventListener("input", function() {
        charCount.textContent = messageInput.value.length + "/1000";
      });
    }

    [nameInput, emailInput, messageInput].forEach(function(input) {
      if (input) {
        input.addEventListener("blur", function() {
          if (input.required && !input.value.trim()) {
            showError(input, input === nameInput ? nameError : input === emailInput ? emailError : messageError, "This field is required");
          } else {
            clearError(input, input === nameInput ? nameError : input === emailInput ? emailError : messageError);
          }
        });
        input.addEventListener("input", function() {
          clearError(input, input === nameInput ? nameError : input === emailInput ? emailError : messageError);
        });
      }
    });

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      
      var isValid = true;
      
      if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
        showError(nameInput, nameError, "Please enter your name (2-100 characters)");
        isValid = false;
      }
      
      if (!validateEmail(emailInput.value)) {
        showError(emailInput, emailError, "Please enter a valid email address");
        isValid = false;
      }
      
      if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
        showError(messageInput, messageError, "Please enter a message (10-1000 characters)");
        isValid = false;
      }
      
      if (!isValid) return;
      
      setLoading(true);
      formStatus.classList.add("hidden");
      
      var formData = new FormData(form);
      try {
        var response = await fetch(form.action, { method: "POST", body: formData, headers: { Accept: "application/json" } });
        if (response.ok) {
          showStatus("Message sent successfully! I'll get back to you soon.", false);
          form.reset();
          charCount.textContent = "0/1000";
          setTimeout(function() {
            var lang = document.documentElement.lang || "en";
            window.location.href = "/" + lang + "/thanks/";
          }, 2000);
        } else {
          var data = await response.json();
          console.error("Error response:", data);
          showStatus("There was a problem sending your message. Please try again.", true);
          setLoading(false);
        }
      } catch (error) {
        console.error("Error:", error);
        showStatus("Network error. Please check your connection and try again.", true);
        setLoading(false);
      }
    });
  }
</script>

<style is:global>
  .shiny-sec {
    color: var(--sec);
  }
</style>
