---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import codiay from "../../../../public/codiay.png";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;
---

<Layout
  title="Codiay Agency — Marketing Agency Website | Abdalrahman Midani"
  description="A modern marketing agency website with smooth animations, project showcases, and a contact funnel. Built for performance and conversion."
  ogType="project"
  breadcrumbs={[
    { name: "Projects", url: "https://aboodmidani.github.io/en/projects/" },
    { name: "Codiay Agency", url: "https://aboodmidani.github.io/en/projects/codiay-agency/" }
  ]}
>
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href={`${base}/`} class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href={`${base}/projects`} class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Codiay Agency
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Codiay Agency</h1>
    </div>

    <ProjectDetail
      title="Codiay Agency"
      image={codiay as import("astro").ImageMetadata}
      description="A modern marketing agency website built for Codiay, focused on clean design, smooth scroll animations, and a strong contact funnel. The site showcases the agency's services, portfolio, and team, with a focus on performance and conversion optimization. The design language is bold and confident, fitting for a creative agency that wants to make a strong first impression."
      responsibilities={[
        "Designed and built the full marketing site from scratch",
        "Implemented scroll-triggered animations and a custom cursor effect",
        "Built a portfolio grid with category filtering",
        "Integrated a contact form with email delivery via Formspree",
      ]}
      techStack={["Astro", "Tailwind CSS", "JavaScript", "Formspree", "Netlify"]}
      liveUrl="https://codiay.netlify.app"
      projectSlug="codiay-agency"
    />
  </section>

  <Footer />
</Layout>
