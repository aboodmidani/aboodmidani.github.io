---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import codiay from "../../../public/codiay.png";
import T from "@/components/T.astro";
---

<Layout title="Codiay — Digital Agency Website | Abdalrahman Midani" description="A digital agency website built by Abdalrahman Midani as Technical Lead. Modern Vue.js front-end with responsive design.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Codiay
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Codiay – Digital Agency Website</h1>
    </div>

    <div class="en-only">
      <ProjectDetail
        title="Codiay"
        image={codiay as import("astro").ImageMetadata}
        description="A digital agency platform where I served as Technical Lead. Codiay showcases agency services, portfolio, and client work. I built the front-end architecture, implemented responsive design, and ensured the site met security best practices."
        responsibilities={[
          "Technical Lead for the digital agency platform",
          "Built responsive front-end with Vue.js and modern tooling",
          "Implemented SEO best practices and performance optimization",
          "Integrated analytics, contact forms, and CMS backend",
        ]}
        techStack={["Vue.js", "JavaScript", "Responsive Design", "SEO", "Quasar"]}
      />
    </div>
    <div class="de-only">
      <ProjectDetail
        title="Codiay"
        image={codiay as import("astro").ImageMetadata}
        description="Eine Digitalagentur-Plattform, bei der ich als Technical Lead tätig war. Codiay präsentiert Agenturleistungen, Portfolio und Kundenarbeiten. Ich entwickelte die Front-End-Architektur, implementierte responsives Design und stellte sicher, dass die Website den Sicherheitsbest Practices entsprach."
        responsibilities={[
          "Technical Lead für die Digitalagentur-Plattform",
          "Entwicklung des responsiven Front-Ends mit Vue.js und modernen Tools",
          "Implementierung von SEO-Best-Practices und Leistungsoptimierung",
          "Integration von Analysen, Kontaktformularen und CMS-Backend",
        ]}
        techStack={["Vue.js", "JavaScript", "Responsive Design", "SEO", "Quasar"]}
      />
    </div>
  </section>

  <Footer />
</Layout>
