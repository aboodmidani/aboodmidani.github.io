---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import T from "@/components/T.astro";

export interface Props {
  title: string;
  image: ImageMetadata;
  description: string;
  responsibilities: string[];
  techStack: string[];
  liveUrl?: string;
  sourceUrl?: string;
  projectSlug: string;
}

const { title, image, description, responsibilities, techStack, liveUrl = '', sourceUrl = '' } = Astro.props;
---

<div class="max-w-5xl mx-auto">
  <div class="rounded-2xl overflow-hidden shadow-lg mb-8">
    <Image
      src={image}
      alt={`${title} - project by Abdalrahman Midani`}
      class="w-full h-64 md:h-96 object-cover"
    />
  </div>

  <p class="text-lg text-[var(--white-icon)] leading-relaxed mb-8">
    {description}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <div class="bg-[#1414149c] rounded-2xl p-6 border border-[var(--white-icon-tr)]">
      <h3 class="text-lg font-semibold text-[var(--white)] mb-4"><T key="projectDetail.responsibilities" /></h3>
      <ul class="space-y-2">
        {responsibilities.map((item) => (
          <li class="flex items-start gap-2 text-[var(--white-icon)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)] flex-shrink-0 mt-0.5">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-[#1414149c] rounded-2xl p-6 border border-[var(--white-icon-tr)]">
      <h3 class="text-lg font-semibold text-[var(--white)] mb-4"><T key="projectDetail.techStack" /></h3>
      <div class="flex flex-wrap gap-2">
        {techStack.map((tech) => (
          <span class="px-3 py-1 text-sm bg-[var(--white-icon-tr)] text-[var(--white-icon)] rounded-full border border-[var(--white-icon-tr)]">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>

  {liveUrl || sourceUrl ? (
    <div class="flex gap-4 flex-wrap">
      {liveUrl ? (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-xl border border-[var(--white-icon-tr)] hover:bg-[#1414149c] hover:text-[var(--sec)] transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V8H18.0037V17H16.0037V9.41421Z"/>
          </svg>
          <T key="projectDetail.livePreview" />
        </a>
      ) : null}
      {sourceUrl ? (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-xl border border-[var(--white-icon-tr)] hover:bg-[#1414149c] hover:text-[var(--sec)] transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
          </svg>
          <T key="projectDetail.sourceCode" />
        </a>
      ) : null}
    </div>
  ) : null}
</div>
