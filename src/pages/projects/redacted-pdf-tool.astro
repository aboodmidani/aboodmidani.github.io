---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import pdf from "../../../public/pdf.jpeg";
import T from "@/components/T.astro";
---

<Layout title="Redacted PDF — Privacy Tool | Abdalrahman Midani" description="A privacy-focused PDF redaction tool built by Abdalrahman Midani. Client-side processing, no data upload, built with web security principles.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Redacted PDF
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Redacted PDF – Privacy-Focused PDF Redaction</h1>
    </div>

    <div class="en-only">
      <ProjectDetail
        title="Redacted PDF"
        image={pdf as import("astro").ImageMetadata}
        description="A privacy-first PDF redaction tool that processes everything in the browser. No files are uploaded to any server — all processing happens client-side. Built with a focus on data security and user privacy, it allows users to redact sensitive information from PDF documents before sharing them."
        responsibilities={[
          "Built the client-side PDF rendering and redaction engine",
          "Implemented canvas-based text selection and overlay system",
          "Ensured zero data leaves the browser (privacy-first architecture)",
          "Designed an intuitive UI for document upload, redaction, and export",
        ]}
        techStack={["JavaScript", "HTML/CSS", "PDF.js", "Canvas API", "Netlify"]}
        liveUrl="https://redacted-pdf.netlify.app/"
        sourceUrl="https://gitlab.com/abdmidani/redacted-pdf.git"
      />
    </div>
    <div class="de-only">
      <ProjectDetail
        title="Redacted PDF"
        image={pdf as import("astro").ImageMetadata}
        description="Ein datenschutzorientiertes PDF-Schwärzungstool, das alles im Browser verarbeitet. Keine Dateien werden auf einen Server hochgeladen – die gesamte Verarbeitung erfolgt clientseitig. Entwickelt mit Fokus auf Datensicherheit und Privatsphäre, ermöglicht es Benutzern, vertrauliche Informationen aus PDF-Dokumenten zu schwärzen, bevor sie geteilt werden."
        responsibilities={[
          "Entwicklung der clientseitigen PDF-Rendering- und Schwärzungs-Engine",
          "Implementierung eines canvas-basierten Textauswahl- und Overlay-Systems",
          "Sicherstellung, dass keine Daten den Browser verlassen (Privacy-First-Architektur)",
          "Intuitives UI-Design für Dokumenten-Upload, Schwärzung und Export",
        ]}
        techStack={["JavaScript", "HTML/CSS", "PDF.js", "Canvas API", "Netlify"]}
        liveUrl="https://redacted-pdf.netlify.app/"
        sourceUrl="https://gitlab.com/abdmidani/redacted-pdf.git"
      />
    </div>
  </section>

  <Footer />
</Layout>
