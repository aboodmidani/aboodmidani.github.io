---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import phishing from "../../../public/phishing.png";
import T from "@/components/T.astro";
---

<Layout title="Phishing Email Analyzer — Security Tool | Abdalrahman Midani" description="A phishing detection tool that analyzes email headers and content. Built by Abdalrahman Midani to help security teams identify threats.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Phishing Email Analyzer
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Phishing Email Analyzer</h1>
    </div>

    <div class="en-only">
      <ProjectDetail
        title="Phishing Email Analyzer"
        image={phishing as import("astro").ImageMetadata}
        description="A phishing email detection and analysis tool that parses email headers and content to identify suspicious patterns. Built to help security teams quickly assess whether an email is a phishing attempt by analyzing SPF, DKIM, DMARC records, URL analysis, and content-based threat detection."
        responsibilities={[
          "Designed the analysis engine for email header parsing and scoring",
          "Implemented SPF, DKIM, and DMARC verification algorithms",
          "Built the front-end interface for uploading and analyzing emails",
          "Created automated report generation with actionable threat insights",
        ]}
        techStack={["JavaScript", "HTML/CSS", "Email Security", "Python/Flask", "Render"]}
        liveUrl="https://phishing-email-analyzer-jyjj.onrender.com"
        sourceUrl="https://github.com/aboodmidani/phishing-email-analyzer"
      />
    </div>
    <div class="de-only">
      <ProjectDetail
        title="Phishing Email Analyzer"
        image={phishing as import("astro").ImageMetadata}
        description="Ein Phishing-Erkennungs- und Analyse-Tool für E-Mails, das Header und Inhalt analysiert, um verdächtige Muster zu identifizieren. Entwickelt, um Sicherheitsteams bei der schnellen Bewertung von Phishing-Versuchen zu unterstützen – mit SPF-, DKIM- und DMARC-Prüfung, URL-Analyse und inhaltsbasierter Bedrohungserkennung."
        responsibilities={[
          "Entwicklung der Analyse-Engine für E-Mail-Header-Parsing und -Bewertung",
          "Implementierung von SPF-, DKIM- und DMARC-Verifizierungsalgorithmen",
          "Erstellung der Front-End-Oberfläche zum Hochladen und Analysieren von E-Mails",
          "Automatische Berichtserstellung mit umsetzbaren Bedrohungserkenntnissen",
        ]}
        techStack={["JavaScript", "HTML/CSS", "Email Security", "Python/Flask", "Render"]}
        liveUrl="https://phishing-email-analyzer-jyjj.onrender.com"
        sourceUrl="https://github.com/aboodmidani/phishing-email-analyzer"
      />
    </div>
  </section>

  <Footer />
</Layout>
