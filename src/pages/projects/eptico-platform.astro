---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import eptico from "../../../public/eptico.png";
---

<Layout title="Eptico — Innovation Platform | Abdalrahman Midani" description="An innovation company platform built by Abdalrahman Midani using Vue.js and responsive web development.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline">Projects</a>
        <span class="mx-2">/</span>
        Eptico
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Eptico – Innovation Company Platform</h1>
    </div>

    <ProjectDetail
      title="Eptico"
      image={eptico as import("astro").ImageMetadata}
      description="An integrated innovation company website built with Vue.js. Eptico required a modern, responsive front-end that communicates innovation and professionalism. I developed the complete front-end, focusing on performance, accessibility, and cross-browser compatibility."
      responsibilities={[
        "Full front-end development of the innovation company platform",
        "Responsive design optimized for all devices and browsers",
        "Performance optimization and fast loading times",
        "Clean, maintainable component architecture",
      ]}
      techStack={["Vue.js", "JavaScript", "HTML/CSS", "Responsive Design"]}
    />
  </section>

  <Footer />
</Layout>
