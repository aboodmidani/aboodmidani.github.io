---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import tonb from "../../../public/tonb.png";
import T from "@/components/T.astro";
---

<Layout title="Tonb — Blockchain Banking Platform | Abdalrahman Midani" description="A blockchain banking platform where Abdalrahman Midani served as Technical Lead. Built with Vue.js, Web3, and modern web technologies.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Tonb
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Tonb – Blockchain Banking Platform</h1>
    </div>

    <div class="en-only">
      <ProjectDetail
        title="Tonb"
        image={tonb as import("astro").ImageMetadata}
        description="A blockchain-based banking platform where I served as Technical Lead. Tonb combines traditional banking functionality with decentralized finance (DeFi) features. I led the front-end development team, architected the Vue.js component system, and ensured secure integration with blockchain smart contracts."
        responsibilities={[
          "Led the front-end development team as Technical Lead",
          "Architected the Vue.js component library and state management",
          "Implemented secure wallet integration and transaction flows",
          "Established coding standards and code review practices",
          "Coordinated with blockchain engineers on smart contract integration",
        ]}
        techStack={["Vue.js", "JavaScript", "Blockchain", "Web3", "Quasar"]}
      />
    </div>
    <div class="de-only">
      <ProjectDetail
        title="Tonb"
        image={tonb as import("astro").ImageMetadata}
        description="Eine blockchain-basierte Banking-Plattform, bei der ich als Technical Lead tätig war. Tonb kombiniert traditionelle Banking-Funktionen mit DeFi-Funktionen (dezentrale Finanzen). Ich leitete das Front-End-Entwicklungsteam, entwickelte die Vue.js-Komponentenarchitektur und sorgte für die sichere Integration mit Blockchain-Smart-Contracts."
        responsibilities={[
          "Leitung des Front-End-Entwicklungsteams als Technical Lead",
          "Architektur der Vue.js-Komponentenbibliothek und des State-Managements",
          "Implementierung sicherer Wallet-Integration und Transaktionsabläufe",
          "Etablierung von Codierungsstandards und Code-Review-Praktiken",
          "Koordination mit Blockchain-Ingenieuren bei der Smart-Contract-Integration",
        ]}
        techStack={["Vue.js", "JavaScript", "Blockchain", "Web3", "Quasar"]}
      />
    </div>
  </section>

  <Footer />
</Layout>
