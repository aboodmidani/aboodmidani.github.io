---
import PageLoader from "@/components/PageLoader.astro";
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Abdalrahman Midani — senior front-end developer and cybersecurity specialist in Ochtrup, North Rhine-Westphalia. Building secure, high-performance web applications for businesses in Germany.", noindex = false } = Astro.props;

const siteUrl = "https://aboodmidani.github.io";
const imageUrl = "https://aboodmidani.github.io/og-image.svg";
const currentUrl = new URL(Astro.url.pathname, siteUrl);
const keywords = "web developer north rhine westphalia, cybersecurity specialist germany, front-end developer NRW, cybersecurity ochtrup, web security expert nordrhein-westfalen, senior front-end developer germany, vulnerability analysis, web application security, abdalrahman midani";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Abdalrahman Midani" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <link rel="canonical" href={currentUrl} />

    <!-- Geo Tags -->
    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Ochtrup" />
    <meta name="geo.position" content="52.2079;7.1894" />
    <meta name="ICBM" content="52.2079, 7.1894" />

    <!-- Hreflang -->
    <link rel="alternate" href={`${siteUrl}/`} hreflang="en" />
    <link rel="alternate" href={`${siteUrl}/`} hreflang="de" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Abdalrahman Midani" />
    <meta property="og:locale" content="en" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content="@aboodmidani" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#101010" />
    <meta name="msapplication-TileColor" content="#101010" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" />

    <!-- Performance: Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Fonts: Non-render-blocking -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "name": "Abdalrahman Midani",
          "url": siteUrl,
          "image": imageUrl,
          "sameAs": [
            "https://gitlab.com/abdmidani",
            "https://github.com/aboodmidani",
            "https://www.linkedin.com/in/abdalrahman-midani/",
            "https://tryhackme.com/p/Jbril"
          ],
          "jobTitle": "Junior Cybersecurity Specialist & Senior Front-end Developer",
          "email": "aboodmidani0@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ochtrup",
            "addressRegion": "North Rhine-Westphalia",
            "addressCountry": "DE"
          },
          "knowsAbout": ["Cybersecurity", "Web Security", "OWASP Top 10", "Vue.js", "JavaScript", "React"],
          "description": "Senior front-end developer and cybersecurity specialist based in Ochtrup, Germany. Specializing in secure web applications and vulnerability analysis.",
          "alumniOf": [
            {
              "@type": "CollegeOrUniversity",
              "name": "Üsküdar Üniversitesi",
              "sameAs": "https://uskudar.edu.tr"
            }
          ]
        },
        {
          "@type": "WebSite",
          "url": siteUrl,
          "name": "Abdalrahman Midani - Web Developer & Cybersecurity Specialist",
          "description": "Senior front-end developer and cybersecurity specialist serving clients in North Rhine-Westphalia and across Germany.",
          "inLanguage": "en",
          "about": ["Web Development", "Cybersecurity", "Front-end Development", "Web Security"],
          "isAccessibleForFree": true
        },
        {
          "@type": "LocalBusiness",
          "@id": siteUrl,
          "name": "Abdalrahman Midani",
          "description": "Senior front-end developer and cybersecurity specialist based in Ochtrup, NRW, Germany.",
          "url": siteUrl,
          "email": "aboodmidani0@gmail.com",
          "telephone": "+4915771454456",
          "areaServed": ["DE-NW", "DE", "EU"],
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ochtrup",
            "addressRegion": "North Rhine-Westphalia",
            "addressCountry": "DE"
          },
          "images": [imageUrl]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": siteUrl
            }
          ]
        }
      ]
    })} />
  </head>
  <body class="bg-[--background] md:px-48 lg:px-20 px-9">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--sec)] focus:text-[var(--background)] focus:rounded-lg focus:font-medium"
    >
      Skip to main content
    </a>

    <PageLoader />

    <main id="main-content" class="page-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #8fff9f;
    --white: #dfdfdf;
    --white-icon: #b3b3b3;
    --white-icon-tr: rgba(243, 243, 243, 0.06);
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Improved focus styles for accessibility */
  :focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 2px;
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #444;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #333 var(--background);
  }

  /* Page transitions */
  .page-content {
    animation: pageIn 0.6s ease-out forwards;
  }

  @keyframes pageIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Fade in up animation for sections */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Make first section visible immediately */
  section:first-of-type {
    opacity: 1 !important;
    transform: none !important;
  }

  /* Screen reader only class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  // Intersection Observer for fade-in animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px"
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && !entry.target.dataset.animated) {
        entry.target.classList.add("visible");
        entry.target.dataset.animated = "true";
      }
    });
  }, observerOptions);

  function isInViewport(element: Element) {
    const rect = element.getBoundingClientRect();
    return (
      rect.top < window.innerHeight * 0.85 &&
      rect.bottom > 0
    );
  }

  document.querySelectorAll("section").forEach((section) => {
    if (!isInViewport(section)) {
      section.classList.add("fade-in-up");
      observer.observe(section);
    } else {
      section.classList.add("visible");
      section.dataset.animated = "true";
    }
  });

  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: "smooth" });
      }, 100);
    }
  }

  var readingSpans = document.querySelectorAll('.reading-time');
  if (readingSpans.length) {
    var article = document.querySelector('article') || document.querySelector('.prose');
    if (article) {
      var text = article.textContent || '';
      var words = text.trim().split(/\s+/).length;
      var mins = Math.max(1, Math.ceil(words / 200));
      for (var i = 0; i < readingSpans.length; i++) {
        readingSpans[i].textContent = mins;
      }
    }
  }
</script>
