---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;
---

<Layout title="Kontakt | Abdalrahman Midani — Webentwickler in Ochtrup, NRW" description="Kontaktiere Abdalrahman Midani — Senior Front-End-Entwickler und Cybersecurity-Spezialist aus Ochtrup, Nordrhein-Westfalen.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs text-[var(--sec)] uppercase tracking-[0.3em] mb-3 font-medium"><T key="contactPage.tagline" /></p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4"><T key="contactPage.heading" /></h1>
      <p class="text-lg text-[var(--white-icon)] max-w-2xl mb-12">
        <T key="contactPage.subtitle" />
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="text-[var(--white-icon)] space-y-4">
          <p class="mb-4">
            Ich habe meinen Sitz in <strong class="text-[var(--white)]">Ochtrup, Nordrhein-Westfalen</strong> und bin für Projekte in ganz Deutschland sowie remote in ganz Europa verfügbar.
          </p>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Ochtrup, Deutschland</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <a href="tel:+4915771454456" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">+49 15771454456</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <a href="mailto:aboodmidani0@gmail.com" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">aboodmidani0@gmail.com</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 text-[var(--sec)]"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
            <a href="https://tryhackme.com/p/Jbril" target="_blank" class="text-[var(--white)] hover:text-[var(--sec)] transition-colors">TryHackMe — @Jbril</a>
          </div>
        </div>

        <div>
          <form
            id="contact-form"
            action="https://formspree.io/f/manydoqj"
            method="POST"
            class="flex flex-col gap-4"
          >
            <input
              type="text"
              name="from_name"
              placeholder="Dein Name"
              required
              class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
            />
            <input
              type="email"
              name="reply_to"
              placeholder="Deine E-Mail"
              required
              class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
            />
            <textarea
              name="message"
              placeholder="Deine Nachricht"
              rows="5"
              required
              class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
            ></textarea>
            <button
              type="submit"
              class="px-6 py-3 bg-[var(--sec)] text-black font-medium rounded-xl hover:opacity-90 transition-opacity"
            >
              <T key="contactPage.formSend" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  var form = document.getElementById("contact-form");
  if (form) {
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var formData = new FormData(form);
      var submitBtn = form.querySelector('button[type="submit"]');
      var originalText = submitBtn.textContent;
      submitBtn.textContent = "Wird gesendet...";
      submitBtn.disabled = true;
      try {
        var response = await fetch(form.action, { method: "POST", body: formData, headers: { Accept: "application/json" } });
        if (response.ok) {
          var lang = document.documentElement.lang || "en";
          window.location.href = "/" + lang + "/thanks/";
        } else {
          var data = await response.json();
          console.error("Error response:", data);
          alert("Es gab ein Problem beim Senden deiner Nachricht. Bitte versuche es erneut.");
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      } catch (error) {
        console.error("Error:", error);
        alert("Es gab ein Problem beim Senden deiner Nachricht. Bitte versuche es erneut.");
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #8fff9f 25%, #eee5ff 50%, #8fff9f 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% { background-position: 100% 50%; }
    30%, 70% { background-position: 0% 50%; }
  }
</style>
