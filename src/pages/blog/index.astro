---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import BlogCard from "@/components/BlogCard.astro";
import T from "@/components/T.astro";
---

<Layout title="Blog | Abdalrahman Midani — Web Developer & Cybersecurity Specialist" description="Articles on web development, cybersecurity, and secure application design by Abdalrahman Midani, a front-end developer in Ochtrup, North Rhine-Westphalia.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs text-[var(--sec)] uppercase tracking-[0.3em] mb-3 font-medium"><T key="blogPage.tagline" /></p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4"><T key="blogPage.heading" /></h1>
      <p class="text-lg text-[var(--white-icon)] max-w-2xl mb-12">
        <T key="blogPage.subtitle" />
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 en-only">
        <BlogCard title="Web Development Services in North Rhine-Westphalia – What to Expect" excerpt="Looking for a web developer in NRW? Here's what a professional front-end development engagement looks like, from requirements to deployment." slug="web-development-services-nrw" date="2025-06-01" readingTime="2 min read" />
        <BlogCard title="Top 10 Cybersecurity Tips for Small Businesses in Germany" excerpt="Protect your business from common cyber threats. Practical security advice for German SMEs based on OWASP guidelines and real-world experience." slug="cybersecurity-tips-germany" date="2025-05-25" readingTime="2 min read" />
        <BlogCard title="How to Hire the Best Front-End Developer in NRW" excerpt="What to look for when hiring a front-end developer in North Rhine-Westphalia. Skills, portfolio, security awareness, and cultural fit." slug="hire-frontend-developer-nrw" date="2025-05-18" readingTime="2 min read" />
        <BlogCard title="Understanding OWASP Top 10 – A Developer's Guide to Web Security" excerpt="Every developer should know these vulnerabilities. A practical walkthrough of the OWASP Top 10 with code examples and mitigations." slug="owasp-top-10-guide" date="2025-05-10" readingTime="2 min read" />
        <BlogCard title="Freelance Web Developer in Germany – Rates, Contracts, and Tips" excerpt="Thinking of hiring a freelance web developer in Germany? Here's what you need to know about rates, contracts, and finding the right fit." slug="freelance-web-developer-germany" date="2025-05-03" readingTime="2 min read" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 de-only">
        <BlogCard title="Webentwicklung in Nordrhein-Westfalen – Was dich erwartet" excerpt="Du suchst einen Webentwickler in NRW? Hier erfährst du, wie eine professionelle Front-End-Entwicklung abläuft – von den Anforderungen bis zum Deployment." slug="web-development-services-nrw" date="2025-06-01" readingTime="2 Min. Lesezeit" />
        <BlogCard title="Die 10 wichtigsten Cybersicherheitstipps für kleine Unternehmen in Deutschland" excerpt="Schütze dein Unternehmen vor häufigen Cyberbedrohungen. Praktische Sicherheitstipps basierend auf OWASP-Richtlinien und praktischer Erfahrung." slug="cybersecurity-tips-germany" date="2025-05-25" readingTime="2 Min. Lesezeit" />
        <BlogCard title="So findest du den besten Front-End-Entwickler in NRW" excerpt="Worauf du bei der Einstellung eines Front-End-Entwicklers in Nordrhein-Westfalen achten solltest. Fähigkeiten, Portfolio, Sicherheitsbewusstsein und kulturelle Passung." slug="hire-frontend-developer-nrw" date="2025-05-18" readingTime="2 Min. Lesezeit" />
        <BlogCard title="OWASP Top 10 verstehen – Ein Leitfaden für Entwickler zur Websicherheit" excerpt="Jeder Entwickler sollte diese Schwachstellen kennen. Ein praktischer Leitfaden durch die OWASP Top 10 mit Codebeispielen und Schutzmaßnahmen." slug="owasp-top-10-guide" date="2025-05-10" readingTime="2 Min. Lesezeit" />
        <BlogCard title="Freiberuflicher Webentwickler in Deutschland – Preise, Verträge und Tipps" excerpt="Du überlegst, einen freiberuflichen Webentwickler in Deutschland zu engagieren? Hier erfährst du alles über Preise, Verträge und die richtige Wahl." slug="freelance-web-developer-germany" date="2025-05-03" readingTime="2 Min. Lesezeit" />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
