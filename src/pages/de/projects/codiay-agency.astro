---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import codiay from "../../../../public/codiay.png";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;
---

<Layout title="Codiay Agency — Marketing-Agentur-Website | Abdalrahman Midani" description="Eine moderne Marketing-Agentur-Website mit flüssigen Animationen, Projektpräsentationen und Kontakt-Funnel. Auf Performance und Conversion optimiert.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href={`${base}/`} class="hover:underline"><T key="nav.home" /></a>
        <span class="mx-2">/</span>
        <a href={`${base}/projects`} class="hover:underline"><T key="nav.projects" /></a>
        <span class="mx-2">/</span>
        Codiay Agency
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Codiay Agency</h1>
    </div>

    <ProjectDetail
      title="Codiay Agency"
      image={codiay as import("astro").ImageMetadata}
      description="Eine moderne Marketing-Agentur-Website für Codiay, mit Fokus auf sauberes Design, flüssige Scroll-Animationen und einen starken Kontakt-Funnel. Die Seite präsentiert die Leistungen, das Portfolio und das Team der Agentur, mit Schwerpunkt auf Performance und Conversion-Optimierung. Die Designsprache ist mutig und selbstbewusst — passend für eine Kreativagentur, die einen starken ersten Eindruck hinterlassen will."
      responsibilities={[
        "Konzeption und Umsetzung der kompletten Marketing-Website",
        "Implementierung von scroll-gesteuerten Animationen und einem benutzerdefinierten Cursor-Effekt",
        "Aufbau eines Portfolio-Grids mit Kategorie-Filterung",
        "Integration eines Kontaktformulars mit E-Mail-Versand über Formspree",
      ]}
      techStack={["Astro", "Tailwind CSS", "JavaScript", "Formspree", "Netlify"]}
      liveUrl="https://codiay.netlify.app"
      projectSlug="codiay-agency"
    />
  </section>

  <Footer />
</Layout>
