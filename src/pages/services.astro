---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ServiceCard from "@/components/ServiceCard.astro";
---

<Layout title="Services | Abdalrahman Midani — Web Developer & Cybersecurity Specialist" description="Web development, cybersecurity audits, and technical consulting services by Abdalrahman Midani. Serving businesses in North Rhine-Westphalia, Germany.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-md text-[var(--sec)] shiny-sec mb-2">What I offer</p>
      <h1 class="text-4xl md:text-6xl font-medium mb-4">Services</h1>
      <p class="text-lg text-[var(--white-icon)] max-w-2xl mb-12">
        Senior front-end development and cybersecurity services for businesses across North Rhine-Westphalia, Germany. Based in Ochtrup, serving clients throughout NRW and beyond.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ServiceCard
          title="Front-End Web Development"
          description="High-performance, responsive web applications built with Vue.js, React, and modern frameworks. I deliver clean, maintainable code optimized for speed and accessibility. Whether you need a landing page or a complex dashboard, I build it secure from day one."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>'
          keywords="front-end developer NRW, vue.js developer germany, react developer north rhine westphalia"
        />
        <ServiceCard
          title="Web Security Audits"
          description="Comprehensive security audits using my own Matrix Web Audit tool. I analyze your web applications for OWASP Top 10 vulnerabilities, misconfigurations, and security gaps. Get a detailed report with actionable fixes tailored to your stack."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm0-2a8 8 0 100-16 8 8 0 000 16zm1-5h-2v2h2v-2zm0-8h-2v6h2V7z"/></svg>'
          keywords="web security audit germany, vulnerability analysis NRW, OWASP testing"
        />
        <ServiceCard
          title="Cybersecurity Consulting"
          description="Expert guidance on web application security, penetration testing methodology, and secure development practices. I help teams in Germany understand and mitigate cyber risks, from phishing defense to secure authentication implementation."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/></svg>'
          keywords="cybersecurity consultant germany, penetration testing NRW, security specialist ochtrup"
        />
        <ServiceCard
          title="Secure Application Development"
          description="Full-cycle development with security built into every layer. From architecture to deployment, I implement authentication, input validation, CSRF protection, and secure data handling. Perfect for German businesses that need GDPR-compliant web solutions."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2zm10 0h2v2h-2v-2zm-6-4h8v2h-8v-2z"/></svg>'
          keywords="secure web development germany, GDPR compliant web developer, full-stack developer NRW"
        />
        <ServiceCard
          title="Technical Leadership"
          description="Experienced technical lead for digital agencies and startups. I guide development teams, establish coding standards, review security practices, and ensure project delivery. Previously served as Technical Lead at Tonb and Codiay."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>'
          keywords="technical lead germany, web development team lead NRW, freelance tech lead"
        />
        <ServiceCard
          title="Vulnerability Analysis"
          description="Deep-dive security assessments of your web infrastructure. Using hands-on techniques and industry-standard tools, I identify XSS, SQL injection, CSRF, and other critical vulnerabilities. Based on OWASP Top 10 methodology with actionable reports."
          icon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2zm10 0h2v2h-2v-2zm-6-4h8v2h-8v-2z"/></svg>'
          keywords="vulnerability analysis north rhine westphalia, penetration testing germany, web security assessment"
        />
      </div>

      <div class="mt-16 text-center">
        <h2 class="text-2xl font-semibold mb-4">Ready to work together?</h2>
        <p class="text-[var(--white-icon)] mb-6 max-w-xl mx-auto">
          Based in Ochtrup, NRW — available for projects throughout Germany and remotely across Europe.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-xl border border-[var(--white-icon-tr)] hover:bg-[#1414149c] hover:text-[var(--sec)] transition-all text-lg"
        >
          Get in touch
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V8H18.0037V17H16.0037V9.41421Z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
