---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import tonb from "../../../public/tonb.png";
---

<Layout title="Tonb — Blockchain Banking Platform | Abdalrahman Midani" description="A blockchain banking platform where Abdalrahman Midani served as Technical Lead. Built with Vue.js, Web3, and modern web technologies.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm text-[var(--sec)] mb-4">
        <a href="/" class="hover:underline">Home</a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:underline">Projects</a>
        <span class="mx-2">/</span>
        Tonb
      </p>
      <h1 class="text-3xl md:text-5xl font-medium mb-8">Tonb – Blockchain Banking Platform</h1>
    </div>

    <ProjectDetail
      title="Tonb"
      image={tonb as import("astro").ImageMetadata}
      description="A blockchain-based banking platform where I served as Technical Lead. Tonb combines traditional banking functionality with decentralized finance (DeFi) features. I led the front-end development team, architected the Vue.js component system, and ensured secure integration with blockchain smart contracts."
      responsibilities={[
        "Led the front-end development team as Technical Lead",
        "Architected the Vue.js component library and state management",
        "Implemented secure wallet integration and transaction flows",
        "Established coding standards and code review practices",
        "Coordinated with blockchain engineers on smart contract integration",
      ]}
      techStack={["Vue.js", "JavaScript", "Blockchain", "Web3", "Quasar"]}
    />
  </section>

  <Footer />
</Layout>
