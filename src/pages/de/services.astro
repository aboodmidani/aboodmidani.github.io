---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;

const services = [
  {
    title: "Front-End-Webentwicklung",
    description: "Hochperformante, responsive Webanwendungen mit Vue.js, React und modernen Frameworks. Ich liefere sauberen, wartbaren Code, der für Geschwindigkeit und Barrierefreiheit optimiert ist. Ob Landingpage oder komplexes Dashboard — ich baue es von Anfang an sicher.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>',
    keywords: "Front-End-Entwickler NRW, Vue.js Entwickler Deutschland, React Entwickler Nordrhein-Westfalen",
  },
  {
    title: "Web-Sicherheitsaudits",
    description: "Umfassende Sicherheitsaudits mit meinem eigenen Matrix-Web-Audit-Tool. Ich analysiere deine Webanwendungen auf OWASP-Top-10-Schwachstellen, Fehlkonfigurationen und Sicherheitslücken. Du bekommst einen detaillierten Bericht mit umsetzbaren Lösungen.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm0-2a8 8 0 100-16 8 8 0 000 16zm1-5h-2v2h2v-2zm0-8h-2v6h2V7z"/></svg>',
    keywords: "Web-Sicherheitsaudit Deutschland, Schwachstellenanalyse NRW, OWASP-Tests",
  },
  {
    title: "Cybersicherheitsberatung",
    description: "Fachkundige Beratung zu Webanwendungssicherheit, Penetrationstests und sicheren Entwicklungspraktiken. Ich helfe Teams in Deutschland, Cyberrisiken zu verstehen und zu minimieren — von Phishing-Abwehr bis zur sicheren Authentifizierung.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/></svg>',
    keywords: "Cybersicherheitsberater Deutschland, Penetrationstests NRW, Sicherheitsspezialist Ochtrup",
  },
  {
    title: "Sichere Anwendungsentwicklung",
    description: "Komplette Entwicklung mit integrierter Sicherheit in jeder Schicht. Von der Architektur bis zum Deployment implementiere ich Authentifizierung, Eingabevalidierung, CSRF-Schutz und sichere Datenverarbeitung. Perfekt für Unternehmen, die DSGVO-konforme Lösungen brauchen.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2zm10 0h2v2h-2v-2zm-6-4h8v2h-8v-2z"/></svg>',
    keywords: "Sichere Webentwicklung Deutschland, DSGVO-konformer Webentwickler, Full-Stack-Entwickler NRW",
  },
  {
    title: "Technische Führung",
    description: "Erfahrener Technical Lead für digitale Agenturen und Startups. Ich leite Entwicklungsteams, erstelle Codierungsstandards, überprüfe Sicherheitspraktiken und stelle die Projektlieferung sicher. Zuvor Technical Lead bei Tonb und Codiay.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>',
    keywords: "Technical Lead Deutschland, Webentwicklung Teamleiter NRW, Freiberuflicher Tech Lead",
  },
  {
    title: "Schwachstellenanalyse",
    description: "Tiefgehende Sicherheitsbewertungen deiner Webinfrastruktur. Mit praktischen Techniken und Branchenstandards identifiziere ich XSS, SQL Injection, CSRF und andere kritische Schwachstellen. Basierend auf der OWASP-Top-10-Methodik mit umsetzbaren Berichten.",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-10"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2zm10 0h2v2h-2v-2zm-6-4h8v2h-8v-2z"/></svg>',
    keywords: "Schwachstellenanalyse Nordrhein-Westfalen, Penetrationstests Deutschland, Web-Sicherheitsbewertung",
  },
];
---

<Layout title="Leistungen | Abdalrahman Midani — Webentwickler & Cybersecurity-Spezialist" description="Webentwicklung, Cybersicherheitsaudits und technische Beratung von Abdalrahman Midani. Für Unternehmen in Nordrhein-Westfalen und ganz Deutschland.">
  <Nav />

  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs text-[var(--sec)] uppercase tracking-[0.3em] mb-3 font-medium"><T key="servicesPage.title" /></p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4"><T key="servicesPage.heading" /></h1>
      <p class="text-lg text-[var(--white-icon)] max-w-2xl mb-12">
        <T key="servicesPage.subtitle" />
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <ServiceCard title={service.title} description={service.description} icon={service.icon} keywords={service.keywords} />
        ))}
      </div>

      <div class="mt-16 text-center">
        <h2 class="text-2xl font-semibold mb-4"><T key="servicesPage.ctaTitle" /></h2>
        <p class="text-[var(--white-icon)] mb-6 max-w-xl mx-auto">
          <T key="servicesPage.ctaSubtitle" />
        </p>
        <a
          href={`${base}/contact`}
          class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-xl border border-[var(--white-icon-tr)] hover:bg-[#1414149c] hover:text-[var(--sec)] transition-all text-lg"
        >
          <T key="servicesPage.ctaButton" />
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V8H18.0037V17H16.0037V9.41421Z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
