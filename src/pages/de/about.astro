---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import EducationData from "@/components/education.astro";
import CertificatesData from "@/components/certificates.astro";
import LanguagesData from "@/components/languages.astro";
import AwardsData from "@/components/awards.astro";
import LogoWall from "@/components/logoWall.astro";
import SkillsList from "@/React/SkillsList.tsx";
import LetterGlitch from "@/React/LetterGlitch.tsx";
import T from "@/components/T.astro";
const locale = Astro.currentLocale === "de" ? "de" : "en";
const base = `/${locale}`;
---

<Layout
  title="Über mich | Abdalrahman Midani — Webentwickler in Ochtrup, NRW"
  description="Lerne Abdalrahman Midani kennen — Senior Front-End-Entwickler und Cybersecurity-Spezialist aus Ochtrup, Nordrhein-Westfalen. Ausbildung, Fähigkeiten und Erfahrung."
  breadcrumbs={[
    { name: "Über mich", url: "https://aboodmidani.github.io/de/about/" }
  ]}
>
  <Nav />

  <!-- Bio -->
  <section class="text-[var(--white)] py-16">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs text-[var(--sec)] uppercase tracking-[0.3em] mb-3 font-medium"><T key="about.title" /></p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-8"><T key="site.name" /></h1>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="md:col-span-2 space-y-4">
          <p class="text-lg text-[var(--white-icon)] leading-relaxed">
            Ich bin ein Senior Front-End-Entwickler und Junior Cybersecurity-Spezialist mit Sitz in <strong class="text-[var(--white)]">Ochtrup, Nordrhein-Westfalen, Deutschland</strong>. Ich kombiniere moderne Front-End-Entwicklung mit Websicherheit, um Anwendungen zu bauen, die schön und sicher sind.
          </p>
          <p class="text-[var(--white-icon)] leading-relaxed">
            Ich habe einen Master in Cyber Security und einen Bachelor in Software Engineering von der Üsküdar Üniversitesi in Istanbul. Meine Erfahrung reicht vom Aufbau von Blockchain-Banking-Plattformen als Technical Lead bei Tonb bis zur Durchführung von Sicherheitsanalysen und dem Bau von Sicherheitstools wie Matrix Web Audit.
          </p>
          <p class="text-[var(--white-icon)] leading-relaxed">
            Heute arbeite ich für Kunden in ganz Deutschland — von Startups in Münster bis zu Agenturen in Düsseldorf und Berlin. Egal, ob du ein sicheres Front-End, eine Sicherheitsanalyse oder technische Führung brauchst — ich bringe Handwerkskunst und Sicherheitsdenken in jedes Projekt.
          </p>
          <p class="text-[var(--white-icon)] leading-relaxed">
            Meine Expertise umfasst die <span class="text-[var(--sec)] shiny-sec">OWASP Top 10</span>, Penetrationstests, Vue.js, React und moderne Front-End-Frameworks. Wenn ich nicht programmiere oder Sicherheit teste, bin ich auf <a href="https://tryhackme.com/p/Jbril" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:underline">TryHackMe</a>, trage zu Open-Source-Projekten auf <a href="https://gitlab.com/abdmidani" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:underline">GitLab</a> bei oder verbessere mein Deutsch (aktuell B2).
          </p>
        </div>
        <div class="bg-[#1414149c] rounded-2xl p-6 border border-[var(--white-icon-tr)] h-fit">
          <h2 class="text-lg font-semibold mb-4"><T key="about.quickInfoTitle" /></h2>
          <div class="space-y-3 text-sm">
            <div>
              <span class="text-[var(--white-icon)]"><T key="about.location" /></span>
              <p class="text-[var(--white)]">Ochtrup, Nordrhein-Westfalen, Deutschland</p>
            </div>
            <div>
              <span class="text-[var(--white-icon)]"><T key="about.languages" /></span>
              <p class="text-[var(--white)]">Arabisch (Muttersprache), Deutsch (B2), Englisch (C1)</p>
            </div>
            <div>
              <span class="text-[var(--white-icon)]"><T key="about.email" /></span>
              <p class="text-[var(--white)]">aboodmidani0@gmail.com</p>
            </div>
            <div>
              <span class="text-[var(--white-icon)]"><T key="about.phone" /></span>
              <p class="text-[var(--white)]">+49 15771454456</p>
            </div>
            <div>
              <span class="text-[var(--white-icon)]"><T key="about.focus" /></span>
              <p class="text-[var(--white)]">Front-End-Entwicklung, Web-Sicherheit, OWASP Top 10, Vue.js, React</p>
            </div>
          </div>
          <div class="mt-6 pt-6 border-t border-[var(--white-icon-tr)]">
            <h3 class="text-sm font-medium text-[var(--white-icon)] mb-3"><T key="about.findMe" /></h3>
            <div class="flex gap-3">
              <a href="https://github.com/aboodmidani" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:text-[var(--white)] transition-colors" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/></svg>
              </a>
              <a href="https://gitlab.com/abdmidani" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:text-[var(--white)] transition-colors" aria-label="GitLab">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-6"><path d="M14.975 8.904L14.19 6.55l-1.552-4.67a.268.268 0 00-.255-.18.268.268 0 00-.254.18l-1.552 4.667H5.422L3.87 1.879a.267.267 0 00-.254-.179.267.267 0 00-.254.18l-1.55 4.667-.784 2.357a.515.515 0 00.193.583l6.78 4.812 6.778-4.812a.516.516 0 00.196-.583z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/abdalrahman-midani/" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:text-[var(--white)] transition-colors" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"/></svg>
              </a>
              <a href="https://tryhackme.com/p/Jbril" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:text-[var(--white)] transition-colors" aria-label="TryHackMe">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies & Skills -->
  <section class="text-[var(--white)] pb-16">
    <div class="max-w-5xl mx-auto space-y-12">
      <div>
        <p class="text-sm text-[var(--sec)] uppercase tracking-widest text-center mb-2">Technologien, mit denen ich arbeite</p>
        <LogoWall />
      </div>

      <div class="flex flex-col lg:flex-row items-start lg:items-center gap-8">
        <div class="flex-grow w-full lg:w-auto">
          <SkillsList client:load />
        </div>
        <div class="flex-shrink-0 w-48 h-48 sm:w-64 sm:h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 mx-auto lg:mx-0">
          <LetterGlitch
            client:load
            glitchColors={["#00A86B", "#8FFF9F", "#004F2D"]}
            glitchSpeed={33}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Background -->
  <section class="text-[var(--white)] pb-16 border-t border-[#ffffff10] pt-16">
    <div class="max-w-5xl mx-auto">
      <EducationData />
      <CertificatesData />
      <LanguagesData />
      <AwardsData />
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
  .shiny-sec {
    color: var(--sec);
  }
</style>
