---
export interface Props {
  title: string;
  excerpt: string;
  slug: string;
  date: string;
  readingTime?: string;
}

const { title, excerpt, slug, date, readingTime = "5 min read" } = Astro.props;
---

<a
  href={`/blog/${slug}`}
  class="block group"
>
  <div class="bg-[#1414149c] rounded-2xl p-6 border border-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all duration-300 h-full">
    <div class="flex items-center gap-3 text-sm text-[var(--white-icon)] mb-3">
      <time datetime={date}>{date}</time>
      <span class="w-1 h-1 rounded-full bg-[var(--white-icon-tr)]"></span>
      <span>{readingTime}</span>
    </div>
    <h3 class="text-xl font-semibold text-[var(--white)] mb-2 group-hover:text-[var(--sec)] transition-colors">
      {title}
    </h3>
    <p class="text-[var(--white-icon)] text-sm leading-relaxed">
      {excerpt}
    </p>
    <span class="inline-flex items-center gap-1 mt-4 text-sm text-[var(--sec)] group-hover:gap-2 transition-all">
      Read more
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V8H18.0037V17H16.0037V9.41421Z"/>
      </svg>
    </span>
  </div>
</a>
