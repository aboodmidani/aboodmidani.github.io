---
export interface Props {
  title: string;
  description: string;
  icon: string;
  keywords?: string;
}

const { title, description, icon, keywords } = Astro.props;
---

<div class="card-cinematic p-6 md:p-8 group">
  <div class="text-[var(--sec)] mb-4 transition-transform duration-300 group-hover:scale-110">
    <span set:html={icon} />
  </div>
  <h3 class="text-xl font-semibold text-[var(--white)] mb-3">{title}</h3>
  <p class="text-[var(--white-icon)] leading-relaxed">{description}</p>
  {keywords && (
    <p class="mt-3 text-xs text-[var(--white-icon)] opacity-60">{keywords}</p>
  )}
</div>
